{
  "name": "khidmat-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:gallery": "node scripts/generate-event-gallery.mjs",
    "build": "node scripts/generate-event-gallery.mjs && tsc -b && node scripts/optimize-images.mjs && vite build && node scripts/prerender.mjs",
    "build:spa": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "prerender": "node scripts/prerender.mjs",
