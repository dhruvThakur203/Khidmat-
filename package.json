    "generate:legacy": "python scripts/generate-legacy-artwork.py"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "playwright": "^1.55.0",
    "sharp": "^0.34.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
